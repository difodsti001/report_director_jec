# ---------------------------------------------------------------------------
# .env - Variables de entorno para el servicio de reporte institucional
# NO subir este archivo a control de versiones con valores reales.
# Copiar como .env y reemplazar los placeholders.
# ---------------------------------------------------------------------------

# --- Base de datos: base_ebr_IA y vw_processing_brechas_ebr ---
DSN_DATOS=postgresql://usuario:password@host:5432/nombre_base_datos

# --- Base de datos: reportes_directivo y consultas_directivo (caché) ---
DSN_CACHE=postgresql://usuario:password@host:5432/nombre_base_cache

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=reemplazar_con_la_api_key_real
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=nombre_del_deployment